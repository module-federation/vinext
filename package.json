{
  "name": "@module-federation/vinext-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "build": "turbo run build",
    "build:package": "turbo run build --filter=@module-federation/vinext",
    "check": "turbo run typecheck test build",
    "dev": "turbo run dev",
    "dev:host": "turbo run dev --filter=vinext-host",
    "dev:island": "turbo run dev --filter=vinext-island",
    "dev:remote": "turbo run dev --filter=vinext-remote",
    "preview": "turbo run preview",
    "test": "turbo run test",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "typecheck": "turbo run typecheck",
    "fmt": "oxfmt *",
    "fmt.check": "oxfmt --check *",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "1.62.0",
    "husky": "9.1.7",
    "oxfmt": "0.63.0",
    "turbo": "2.11.7"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "pnpm@10.33.2"
}
